@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@using System.Text.Json.Serialization
@implements IAsyncDisposable
@inject IJSRuntime JS

<style>
    .testimonials-section {
        background-color: #ffffff;
        border: 1px solid #e9ecef;
        border-radius: 12px;
        padding: 24px;
        margin-bottom: 24px;
    }

    .testimonials-section h2 {
        margin-bottom: 16px;
    }

    .testimonial-card {
        background-color: #f8f9fa;
        border-left: 4px solid #74a8f4;
        border-radius: 8px;
        padding: 14px;
        margin-bottom: 12px;
    }

    .testimonial-card p {
        margin-bottom: 0;
    }

    .testimonial-author {
        margin-top: 8px;
        font-weight: 600;
        color: #495057;
    }

    .testimonial-meta {
        display: block;
        margin-top: 2px;
        color: #6c757d;
        font-size: 0.9rem;
    }
</style>

<section class="testimonials-section text-center">
    <h2>@(IsHomeSection ? "What Families Are Saying" : "Testimonials")</h2>

    <div class="row g-3">
        @foreach (var review in reviews)
        {
            <div class="col-12 @(IsHomeSection ? "col-md-6 col-lg-4" : "col-md-6")">
                <div class="testimonial-card h-100">
                    @if (!string.IsNullOrWhiteSpace(review.Text))
                    {
                        <p>"@review.Text"</p>
                    }
                    else
                    {
                        <p>Review available on Google.</p>
                    }

                    <p class="testimonial-author">— @review.Author</p>
                    <span class="testimonial-meta">@review.RelativeDate</span>
                    @if (!string.IsNullOrWhiteSpace(review.ProfileUrl))
                    {
                        <a class="testimonial-meta" href="@review.ProfileUrl" target="_blank" rel="noopener noreferrer">View profile</a>
                    }
                </div>
            </div>
        }
    </div>

    <a class="btn btn-outline-primary mt-3"
       target="_blank"
       rel="noopener noreferrer"
       href="https://www.google.com/maps/place/BeyondTheLabel/%4034.0206049,-118.4241617,17z/data=!4m16!1m9!3m8!1s0x80c2bb5547079631:0x8a5f8cd477a0b238!2sBeyondTheLabel!8m2!3d34.0206049!4d-118.4241617!9m1!1b1!16s%2Fg%2F11wxqd81fl!3m5!1s0x80c2bb5547079631:0x8a5f8cd477a0b238!8m2!3d34.0206049!4d-118.4241617!16s%2Fg%2F11wxqd81fl?entry=ttu&amp;g_ep=EgoyMDI2MDcxNC4wIKXMDSoASAFQAw%3D%3D">
        Read More Google Reviews
    </a>
</section>

@code {
    [Parameter] public bool IsHomeSection { get; set; }

    private IJSObjectReference? module;
    private List<GoogleReview> reviews = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/google-reviews.js");
        reviews = await module.InvokeAsync<List<GoogleReview>>("getBeyondTheLabelGoogleReviews") ?? new List<GoogleReview>();
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (module is not null)
        {
            await module.DisposeAsync();
        }
    }

    private class GoogleReview
    {
        [JsonPropertyName("author")]
        public string Author { get; set; } = string.Empty;

        [JsonPropertyName("relativeDate")]
        public string RelativeDate { get; set; } = string.Empty;

        [JsonPropertyName("text")]
        public string Text { get; set; } = string.Empty;

        [JsonPropertyName("profileUrl")]
        public string? ProfileUrl { get; set; }
    }
}
