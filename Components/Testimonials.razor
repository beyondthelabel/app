@using Microsoft.AspNetCore.Components
@using System.Text.Json.Serialization
@inject HttpClient Http

<style>
    .testimonials-section {
        background: linear-gradient(180deg, #f8fbff 0%, #ffffff 100%);
        border: 1px solid #e6eef8;
        border-radius: 18px;
        padding: 28px;
        margin-bottom: 28px;
        opacity: 1;
        transform: none;
    }

    .testimonials-header {
        margin-bottom: 18px;
    }

    .testimonials-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: #2359b6;
        background: #eaf2ff;
        border-radius: 999px;
        padding: 6px 12px;
        margin-bottom: 10px;
    }

    .testimonials-section h2 {
        margin-bottom: 8px;
        font-size: clamp(1.5rem, 2.5vw, 2rem);
        font-weight: 700;
        color: #102a43;
    }

    .testimonials-subtitle {
        margin: 0;
        color: #486581;
        font-size: 1rem;
    }

    .testimonial-card {
        background-color: #ffffff;
        border: 1px solid #dbe7f5;
        border-radius: 14px;
        padding: 16px;
        margin-bottom: 0;
        height: 100%;
        box-shadow: 0 4px 14px rgba(16, 42, 67, 0.06);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .testimonials-scroll {
        display: flex;
        gap: 14px;
        overflow-x: auto;
        padding: 2px 4px 10px;
        scroll-snap-type: x mandatory;
    }

    .testimonial-item {
        flex: 0 0 min(360px, 90vw);
        scroll-snap-align: start;
    }

    .testimonial-link {
        color: inherit;
        text-decoration: none;
        display: block;
        height: 100%;
    }

    .testimonial-link:hover .testimonial-card {
        transform: translateY(-2px);
        box-shadow: 0 10px 24px rgba(16, 42, 67, 0.14);
    }

    .testimonial-card p {
        margin-bottom: 0;
        color: #334e68;
        line-height: 1.55;
    }

    .testimonial-author {
        margin-top: 12px;
        font-weight: 700;
        color: #102a43;
    }

    .testimonial-meta {
        display: block;
        margin-top: 6px;
        color: #486581;
        font-size: 0.85rem;
    }

    .testimonials-section .btn {
        margin-top: 14px !important;
        border-radius: 999px;
        padding: 9px 18px;
        font-weight: 600;
    }

    @@media (max-width: 576px) {
        .testimonials-section {
            padding: 20px;
            border-radius: 14px;
        }
    }
</style>

<section class="testimonials-section">
    <div class="testimonials-header text-center">
        <span class="testimonials-kicker">Google Reviews · 5.0</span>
        <h2>@(IsHomeSection ? "What Families Are Saying" : "Testimonials")</h2>
        <p class="testimonials-subtitle">Real experiences from families we support.</p>
    </div>

    <div class="testimonials-scroll">
        @foreach (var review in reviews)
        {
            <div class="testimonial-item">
                <a class="testimonial-link"
                   href="@ReviewsUrl"
                   target="_blank"
                   rel="noopener noreferrer"
                   aria-label="@($"Read Google review by {review.Author}")">
                    <div class="testimonial-card">
                        @if (!string.IsNullOrWhiteSpace(review.Text))
                        {
                            <p>"@review.Text"</p>
                        }
                        else
                        {
                            <p>Review available on Google.</p>
                        }

                        <p class="testimonial-author">— @review.Author</p>
                    </div>
                </a>
                    @if (!string.IsNullOrWhiteSpace(review.ProfileUrl))
                    {
                        <span class="testimonial-meta">View profile available on Google</span>
                    }
            </div>
        }
    </div>

    <a class="btn btn-outline-primary mt-3"
       target="_blank"
       rel="noopener noreferrer"
       href="@ReviewsUrl">
        Read More Google Reviews
    </a>
</section>

@code {
    [Parameter] public bool IsHomeSection { get; set; }
    private const string ReviewsUrl = "https://www.google.com/search?q=beyondthelabel+los+angeles&rlz=1C1VDKB_enUS1087US1087&oq=beyondthelabel+los+angeles&gs_lcrp=EgZjaHJvbWUyBggAEEUYOTIKCAEQABgKGBYYHjINCAIQABiGAxiABBiKBTIKCAMQABiABBiiBDIHCAQQABjvBTIHCAUQABjvBTIKCAYQABiiBBiJBdIBCDQzNzRqMGo0qAIDsAIB8QXIUuTuBB8-SvEFyFLk7gQfPko&sourceid=chrome&source=chrome.ob&ie=UTF-8#lrd=0x80c2bb5547079631:0x8a5f8cd477a0b238,1,,,,";

    private List<GoogleReview> reviews = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            reviews = await Http.GetFromJsonAsync<List<GoogleReview>>("reviews/google-reviews.json") ?? new List<GoogleReview>();
        }
        catch
        {
            reviews = new List<GoogleReview>();
        }
    }

    private class GoogleReview
    {
        [JsonPropertyName("author")]
        public string Author { get; set; } = string.Empty;

        [JsonPropertyName("relativeDate")]
        public string RelativeDate { get; set; } = string.Empty;

        [JsonPropertyName("text")]
        public string Text { get; set; } = string.Empty;

        [JsonPropertyName("profileUrl")]
        public string? ProfileUrl { get; set; }
    }
}
