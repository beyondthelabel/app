@using Microsoft.AspNetCore.Components
@using System.Text.Json.Serialization
@inject HttpClient Http

<style>
    .testimonials-section {
        background-color: #ffffff;
        border: 1px solid #e9ecef;
        border-radius: 12px;
        padding: 24px;
        margin-bottom: 24px;
        opacity: 1;
        transform: none;
    }

    .testimonials-section h2 {
        margin-bottom: 16px;
    }

    .testimonial-card {
        background-color: #f8f9fa;
        border-left: 4px solid #74a8f4;
        border-radius: 8px;
        padding: 14px;
        margin-bottom: 0;
        height: 100%;
    }

    .testimonials-scroll {
        display: flex;
        gap: 12px;
        overflow-x: auto;
        padding-bottom: 8px;
        scroll-snap-type: x mandatory;
    }

    .testimonial-item {
        flex: 0 0 min(360px, 90vw);
        scroll-snap-align: start;
    }

    .testimonial-link {
        color: inherit;
        text-decoration: none;
        display: block;
        height: 100%;
    }

    .testimonial-link:hover .testimonial-card {
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.12);
    }

    .testimonial-card p {
        margin-bottom: 0;
    }

    .testimonial-author {
        margin-top: 8px;
        font-weight: 600;
        color: #495057;
    }

    .testimonial-meta {
        display: block;
        margin-top: 2px;
        color: #6c757d;
        font-size: 0.9rem;
    }
</style>

<section class="testimonials-section text-center">
    <h2>@(IsHomeSection ? "What Families Are Saying" : "Testimonials")</h2>

    <div class="testimonials-scroll">
        @foreach (var review in reviews)
        {
            <div class="testimonial-item">
                <a class="testimonial-link"
                   href="@ReviewsUrl"
                   target="_blank"
                   rel="noopener noreferrer"
                   aria-label="@($"Read Google review by {review.Author}")">
                    <div class="testimonial-card">
                        @if (!string.IsNullOrWhiteSpace(review.Text))
                        {
                            <p>"@review.Text"</p>
                        }
                        else
                        {
                            <p>Review available on Google.</p>
                        }

                        <p class="testimonial-author">— @review.Author</p>
                    </div>
                </a>
                    @if (!string.IsNullOrWhiteSpace(review.ProfileUrl))
                    {
                        <span class="testimonial-meta">View profile available on Google</span>
                    }
            </div>
        }
    </div>

    <a class="btn btn-outline-primary mt-3"
       target="_blank"
       rel="noopener noreferrer"
       href="@ReviewsUrl">
        Read More Google Reviews
    </a>
</section>

@code {
    [Parameter] public bool IsHomeSection { get; set; }
    private const string ReviewsUrl = "https://www.google.com/search?q=beyondthelabel+los+angeles&rlz=1C1VDKB_enUS1087US1087&oq=beyondthelabel+los+angeles&gs_lcrp=EgZjaHJvbWUyBggAEEUYOTIKCAEQABgKGBYYHjINCAIQABiGAxiABBiKBTIKCAMQABiABBiiBDIHCAQQABjvBTIHCAUQABjvBTIKCAYQABiiBBiJBdIBCDQzNzRqMGo0qAIDsAIB8QXIUuTuBB8-SvEFyFLk7gQfPko&sourceid=chrome&source=chrome.ob&ie=UTF-8#lrd=0x80c2bb5547079631:0x8a5f8cd477a0b238,1,,,,";

    private List<GoogleReview> reviews = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            reviews = await Http.GetFromJsonAsync<List<GoogleReview>>("reviews/google-reviews.json") ?? new List<GoogleReview>();
        }
        catch
        {
            reviews = new List<GoogleReview>();
        }
    }

    private class GoogleReview
    {
        [JsonPropertyName("author")]
        public string Author { get; set; } = string.Empty;

        [JsonPropertyName("relativeDate")]
        public string RelativeDate { get; set; } = string.Empty;

        [JsonPropertyName("text")]
        public string Text { get; set; } = string.Empty;

        [JsonPropertyName("profileUrl")]
        public string? ProfileUrl { get; set; }
    }
}
